{
  "folders": [
    {
      "folder": "preprocessing",
      "title": "Preprocessing",
      "blurb": "Turns raw F-SAR products into the beamformed Capon tomogram, flattened interferometric stack, per-pixel geometry field and stack-overview plots.",
      "diagrams": [
        {
          "key": "preprocessing-generation",
          "stage": "Generation",
          "title": "Stack Generation",
          "entry": "main/processing/pre_process.py",
          "blurb": "The main preprocessing run ingests raw F-SAR products through PyRat, beamforms a Capon tomogram, builds the flattened interferometric stack, derives the per-pixel geometry field, and records an artifact manifest of the run's stack layout.",
          "nodes": [
            {
              "id": "entry",
              "label": "pre_process.py",
              "module": "main/processing/pre_process.py",
              "role": "entry",
              "fn": "Bootstraps the pinned env and builds one ProcessingConfig session per win filter, then hands them to PreProcessScheduler.",
              "col": 0,
              "reads": [],
              "writes": [],
              "row": 0
            },
            {
              "id": "config",
              "label": "ProcessingConfig",
              "module": "configuration/sar/processing_config.py",
              "role": "config",
              "fn": "Dataclass carrying crop, track selection, polarisation, beamforming method and run path settings.",
              "col": 0,
              "reads": [],
              "writes": [],
              "row": 1
            },
            {
              "id": "pipeline",
              "label": "ProcessingPipeline",
              "module": "pipelines/processing/generation/pipeline.py",
              "role": "orchestrator",
              "fn": "Sequences the tomogram, interferometric-inputs and geometry-field stages, then triggers the run manifest write.",
              "col": 1,
              "reads": [],
              "writes": [],
              "row": 1
            },
            {
              "id": "registry",
              "label": "ArtifactRegistry",
              "module": "pipelines/processing/generation/artifacts.py",
              "role": "io",
              "fn": "Creates the run directory structure and resolves the canonical .npy artifact output paths by name.",
              "col": 0,
              "reads": [],
              "writes": [],
              "row": 2
            },
            {
              "id": "tomo_launcher",
              "label": "TomogramLauncher",
              "module": "tools/sar/tomogram_launcher.py",
              "role": "io",
              "fn": "Serialises a tomogram job spec and launches the pyrat-env subprocess (generate_tomogram.py).",
              "col": 2,
              "reads": [],
              "writes": [
                "tomogram_spec.json"
              ],
              "row": 0
            },
            {
              "id": "inf_launcher",
              "label": "InterferogramLauncher",
              "module": "tools/sar/interferogram_launcher.py",
              "role": "io",
              "fn": "Serialises an interferogram job spec, launches the pyrat-env subprocess (generate_interferograms.py) and reads back stack shapes and pass labels.",
              "col": 2,
              "reads": [
                "interferogram_result.json"
              ],
              "writes": [
                "interferogram_spec.json"
              ],
              "row": 2
            },
            {
              "id": "tomo_gen",
              "label": "TomogramGenerator",
              "module": "pipelines/processing/generation/tomogram.py",
              "role": "transform",
              "fn": "Runs in the pyrat env; dispatches PyRat Capon jobs over azimuth subsections via TomogramProcessor and concatenates them into the tomogram cube and DEM.",
              "col": 3,
              "reads": [
                "tomogram_spec.json"
              ],
              "writes": [
                "tomogram_full.npy",
                "dem_full.npy"
              ],
              "row": 0
            },
            {
              "id": "inf_gen",
              "label": "InterferogramGenerator",
              "module": "pipelines/processing/generation/interferogram.py",
              "role": "transform",
              "fn": "Runs in the pyrat env; loads primary/secondary SLCs through PyRat, flattens interferograms by DEM-phase deramping, and extracts track baselines, profiles and parameters.",
              "col": 3,
              "reads": [
                "interferogram_spec.json"
              ],
              "writes": [
                "primary.npy",
                "secondaries.npy",
                "interferograms.npy",
                "track_parameters.json",
                "track_profiles.npz",
                "interferogram_result.json"
              ],
              "row": 2
            },
            {
              "id": "geom",
              "label": "GeometryFieldBuilder",
              "module": "tools/sar/geometry_field.py",
              "role": "transform",
              "fn": "Builds the per-pixel kz geometry field from track parameters and per-azimuth baseline profiles.",
              "col": 4,
              "reads": [
                "track_parameters.json",
                "track_profiles.npz"
              ],
              "writes": [
                "geometry_field.npz"
              ],
              "row": 3
            },
            {
              "id": "meta",
              "label": "MetadataManager",
              "module": "pipelines/processing/generation/artifacts.py",
              "role": "io",
              "fn": "Writes the config snapshot, per-stage metadata files and the dataset.json stack layout manifest.",
              "col": 4,
              "reads": [],
              "writes": [
                "config_state.json",
                "meta_tomogram_full.txt",
                "meta_inputs.txt",
                "dataset.json"
              ],
              "row": 1
            }
          ],
          "edges": [
            {
              "from": "entry",
              "to": "pipeline",
              "label": "sessions per win filter",
              "kind": "control"
            },
            {
              "from": "config",
              "to": "pipeline",
              "label": "crop, tracks, paths",
              "kind": "data"
            },
            {
              "from": "registry",
              "to": "pipeline",
              "label": "resolved .npy paths",
              "kind": "data"
            },
            {
              "from": "pipeline",
              "to": "tomo_launcher",
              "label": "tomogram spec",
              "kind": "data"
            },
            {
              "from": "tomo_launcher",
              "to": "tomo_gen",
              "label": "via pyrat subprocess",
              "kind": "control"
            },
            {
              "from": "pipeline",
              "to": "inf_launcher",
              "label": "interferogram spec",
              "kind": "data"
            },
            {
              "from": "inf_launcher",
              "to": "inf_gen",
              "label": "via pyrat subprocess",
              "kind": "control"
            },
            {
              "from": "inf_launcher",
              "to": "pipeline",
              "label": "shapes + pass_labels",
              "kind": "data"
            },
            {
              "from": "inf_gen",
              "to": "geom",
              "label": "track params + profiles",
              "kind": "data"
            },
            {
              "from": "pipeline",
              "to": "geom",
              "label": "crop + build request",
              "kind": "control"
            },
            {
              "from": "pipeline",
              "to": "meta",
              "label": "stage metadata + config",
              "kind": "data"
            }
          ],
          "artifacts": [
            {
              "name": "tomogram_full.npy",
              "producer": "TomogramGenerator",
              "consumers": [],
              "fmt": "npy",
              "desc": "Beamformed Capon tomogram cube (height x azimuth x range).",
              "scope": "cross"
            },
            {
              "name": "dem_full.npy",
              "producer": "TomogramGenerator",
              "consumers": [
                "StackPlotter"
              ],
              "fmt": "npy",
              "desc": "Full-stack DEM height map over the crop.",
              "scope": "cross"
            },
            {
              "name": "primary/secondaries/interferograms.npy",
              "producer": "InterferogramGenerator",
              "consumers": [
                "StackPlotter"
              ],
              "fmt": "npy",
              "desc": "Primary SLC, secondary SLC stack and DEM-flattened interferometric stack.",
              "scope": "cross"
            },
            {
              "name": "geometry_field.npz",
              "producer": "GeometryFieldBuilder",
              "consumers": [],
              "fmt": "npz",
              "desc": "Per-pixel kz geometry field.",
              "scope": "cross"
            },
            {
              "name": "track_parameters.json / track_profiles.npz",
              "producer": "InterferogramGenerator",
              "consumers": [
                "GeometryFieldBuilder"
              ],
              "fmt": "json+npz",
              "desc": "Per-track acquisition parameters and per-azimuth baseline profiles.",
              "scope": "cross"
            },
            {
              "name": "dataset.json",
              "producer": "MetadataManager",
              "consumers": [
                "StackInferencePipeline"
              ],
              "fmt": "json",
              "desc": "Stack layout manifest: artifact filenames, crop, max_amplitude_clip and pass_labels.",
              "scope": "cross"
            },
            {
              "name": "tomogram_spec.json / interferogram_spec.json",
              "producer": "TomogramLauncher",
              "consumers": [
                "TomogramGenerator",
                "InterferogramGenerator"
              ],
              "fmt": "json",
              "desc": "Job spec handed to the pyrat-env subprocess.",
              "scope": "within"
            }
          ],
          "ncol": 5,
          "nrow": 4
        },
        {
          "key": "preprocessing-analysis",
          "stage": "Analysis",
          "title": "Stack Overview Plots",
          "entry": "main/analysis/analyze_preprocessing.py",
          "blurb": "A decoupled analysis pass that reads each preprocessing run's dataset.json manifest and renders SLC amplitude, interferogram amplitude/phase and DEM overview figures.",
          "nodes": [
            {
              "id": "entry",
              "label": "analyze_preprocessing.py",
              "module": "main/analysis/analyze_preprocessing.py",
              "role": "entry",
              "fn": "Bootstraps the env and runs PreprocessingInferenceScheduler over the selected preprocessing trials.",
              "col": 0,
              "reads": [],
              "writes": [],
              "row": 1
            },
            {
              "id": "config",
              "label": "PreprocessInferenceConfig",
              "module": "configuration/sar/processing_config.py",
              "role": "config",
              "fn": "Dataclass naming the runs directory and the specific run tags (or auto-discovery) to plot.",
              "col": 0,
              "reads": [],
              "writes": [],
              "row": 0
            },
            {
              "id": "collector",
              "label": "StackInferenceTrialCollector",
              "module": "pipelines/processing/generation/inference.py",
              "role": "io",
              "fn": "Discovers preprocessing run directories that contain a data/dataset.json manifest.",
              "col": 1,
              "reads": [
                "dataset.json"
              ],
              "writes": [],
              "row": 0
            },
            {
              "id": "scheduler",
              "label": "PreprocessingInferenceScheduler",
              "module": "pipelines/processing/generation/inference.py",
              "role": "orchestrator",
              "fn": "Sequences one StackInference session per discovered trial run directory.",
              "col": 1,
              "reads": [],
              "writes": [],
              "row": 1
            },
            {
              "id": "stack_pipeline",
              "label": "StackInferencePipeline",
              "module": "pipelines/processing/generation/inference.py",
              "role": "orchestrator",
              "fn": "Reads a run's dataset.json layout and drives the plotter over its stack artifacts.",
              "col": 2,
              "reads": [
                "dataset.json"
              ],
              "writes": [],
