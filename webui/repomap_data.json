    {
      "folder": "shared",
      "title": "Shared Foundation",
      "blurb": "Reusable orchestration scaffolding shared by the processing pipelines: resumable multi-stage state tracking and strictly sequential session scheduling.",
      "diagrams": [
        {
          "key": "shared-orchestration",
          "stage": "Orchestration",
          "title": "Sweep & session orchestration",
          "entry": "",
          "blurb": "Two reusable base orchestrators: StagedPipeline scaffolds multi-stage runs with a resumable per-stage state file, and SequentialSessionScheduler runs preprocessing sessions one at a time through a single-worker process pool.",
          "nodes": [
            {
              "id": "staged_pipeline",
              "label": "StagedPipeline",
              "module": "pipelines/shared/orchestration/staged_pipeline.py",
              "role": "orchestrator",
              "fn": "Sets up the run directory, saves the resolved config, and marks each stage status into state.json.",
              "col": 1,
              "reads": [],
              "writes": [
                "state.json",
                "resolved_config.json"
              ],
              "row": 1
            },
            {
              "id": "session_scheduler",
              "label": "SequentialSessionScheduler",
              "module": "pipelines/shared/orchestration/session_scheduler.py",
              "role": "orchestrator",
              "fn": "Enumerates sessions and dispatches them sequentially, collecting each session's output paths.",
              "col": 1,
              "reads": [],
              "writes": [],
              "row": 2
            },
            {
              "id": "session_subclass",
              "label": "PreProcess / analysis schedulers",
              "module": "pipelines/processing/generation/pipeline.py",
              "role": "external",
              "fn": "Concrete session producers for preprocessing that run one session at a time.",
              "col": 2,
              "reads": [],
              "writes": [],
              "row": 2
            },
            {
              "id": "process_pool",
              "label": "ProcessPoolRunner",
              "module": "tools/orchestration/pool.py",
              "role": "external",
              "fn": "Runs the session callables with a single worker so sessions execute strictly sequentially.",
              "col": 3,
              "reads": [],
              "writes": [],
              "row": 2
            },
            {
              "id": "state_out",
              "label": "state.json / outputs",
              "module": "pipelines/shared/orchestration/staged_pipeline.py",
              "role": "io",
              "fn": "Persisted stage state, resolved config and per-session output paths for resume and downstream use.",
              "col": 4,
              "reads": [],
              "writes": [
                "state.json",
                "resolved_config.json"
              ],
              "row": 1
            }
          ],
          "edges": [
            {
              "from": "session_scheduler",
              "to": "session_subclass",
              "label": "sequential run()",
              "kind": "control"
            },
            {
              "from": "session_subclass",
              "to": "process_pool",
              "label": "sessions + runner",
              "kind": "control"
            },
            {
              "from": "process_pool",
              "to": "state_out",
              "label": "per-session output paths",
              "kind": "data"
            },
            {
              "from": "staged_pipeline",
              "to": "state_out",
              "label": "state + resolved config",
              "kind": "io"
            }
          ],
          "artifacts": [
            {
              "name": "state.json",
              "producer": "staged_pipeline",
              "consumers": [
                "webui",
                "resume"
              ],
              "fmt": "json",
              "desc": "Per-stage status and timestamps tracking a multi-stage sweep.",
              "scope": "within"
            },
            {
              "name": "resolved_config.json",
              "producer": "staged_pipeline",
              "consumers": [
                "stage workers"
              ],
              "fmt": "json",
              "desc": "Fully resolved run config replayed by every spawned stage worker.",
              "scope": "cross"
            },
            {
              "name": "session outputs",
              "producer": "session_subclass",
              "consumers": [
                "analysis"
              ],
              "fmt": "paths",
              "desc": "Per-session output paths (e.g. preprocessing dataset paths) fed downstream.",
              "scope": "cross"
            }
          ],
          "ncol": 5,
          "nrow": 3
        }
      ]
    },
    {
      "folder": "comparison",
      "title": "Comparison",
      "blurb": "The side-by-side comparison pipeline that gathers multiple preprocessing trials and renders markdown reports, metric tables and figure galleries.",
      "diagrams": [
